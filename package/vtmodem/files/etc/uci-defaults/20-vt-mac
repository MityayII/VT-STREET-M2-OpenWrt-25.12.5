#!/bin/sh

TAG="mac-fixer"

log()
{
	echo "<4>[$TAG]: $*" > /dev/kmsg
}

# ШАГ 1: Извлекаем вечный стабильный хэш кремния (Мгновенно, без ожидания USB)
h=$(head -c 64 /dev/mtd2 2>/dev/null | sha256sum | awk '{print $1}')

# Страховка на случай микросекундного сна чипа флеш-памяти
if [ -z "$h" ] || [ "$h" = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
	h=$(printf 'VT-STREET-M2-PERMANENT-CORE-SAFE-SEED' | sha256sum | awk '{print $1}')
fi

# Нарезаем наш уникальный вечный паспорт
MAC="02:$(echo "$h" | cut -c3-4):$(echo "$h" | cut -c5-6):$(echo "$h" | cut -c7-8):$(echo "$h" | cut -c9-10):$(echo "$h" | cut -c11-12)"

log "PROVISIONING DETERMINISTIC NATIVE MAC: $MAC"

# =========================================================================
# ШАГ 2: ЧИСТОКРОВНАЯ UCI-ФИКСАЦИЯ МАКСБАКСА (ДО СТАРТА СЕТЕВОГО СТЕКА)
# =========================================================================

# Намертво прописываем адрес в логический интерфейс LAN
uci set network.lan.macaddr="$MAC"

# Намертво прописываем адрес в физическое DSA-устройство моста br-lan
idx=0
while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
	if [ "$(uci -q get "network.@device[$idx].name")" = "br-lan" ]; then
		uci set "network.@device[$idx].macaddr=$MAC"
		break
	fi
	idx=$((idx + 1))
done

# Жестко сохраняем изменения на постоянный диск роутера
uci commit network

log "UCI network configuration locked to $MAC. Netifd will apply it natively."
exit 0
