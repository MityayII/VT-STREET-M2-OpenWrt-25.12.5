#!/bin/sh

TAG="mac-fixer"

log() {
	echo "<4>[$TAG]: $*" > /dev/kmsg
}

# Считываем чистый хэш из проснувшейся флешки
h=$(head -c 64 /dev/mtd2 2>/dev/null | sha256sum | awk '{print $1}')

if [ -n "$h" ] && [ "$h" != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
	MAC="02:$(echo "$h" | cut -c3-4):$(echo "$h" | cut -c5-6):$(echo "$h" | cut -c7-8):$(echo "$h" | cut -c9-10):$(echo "$h" | cut -c11-12)"
	
	log "SILICON HASH DETECTED. ENFORCING HARDWARE OVERRIDE TO: $MAC"
	
	# === ПРЯМАЯ СИЛОВАЯ ПОДМЕНА В ОПЕРАТИВНОЙ ПАМЯТИ ЯДРА ===
	# Опускаем мост, меняем физический адрес родительского интерфейса и поднимаем обратно
	ip link set dev br-lan down 2>/dev/null
	ip link set dev eth0 down 2>/dev/null
	
	ip link set dev eth0 address "$MAC" 2>/dev/null
	ip link set dev br-lan address "$MAC" 2>/dev/null
	
	ip link set dev eth0 up 2>/dev/null
	ip link set dev br-lan up 2>/dev/null
	
	# Прописываем этот же адрес в конфиг, чтобы LuCI отображала его в статус-баре
	uci set network.lan.macaddr="$MAC"
	uci commit network
	
	log "Hardware registers eth0/br-lan forced to $MAC."
else
	log "WARNING: mtd2 partition read error. Random kernel MAC left untouched."
fi

exit 0
