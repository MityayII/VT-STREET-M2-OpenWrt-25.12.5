#!/bin/sh

TAG="mac-fixer"

log() {
    echo "<4>[$TAG]: $*" > /dev/kmsg
}

# === 1. Чтение заводского MAC по смещению 0x28 ===
OFFSET=40
mac_raw=$(dd if=/dev/mtd2 bs=1 skip=$OFFSET count=6 2>/dev/null | hexdump -v -e '6/1 "%02x"')

MAC=""
if [ -n "$mac_raw" ] && [ "$mac_raw" != "ffffffffffff" ] && [ "$mac_raw" != "000000000000" ]; then
    first_byte=$(echo "$mac_raw" | cut -c1-2)
    if [ $((0x$first_byte & 1)) -eq 0 ]; then
        MAC=$(echo "$mac_raw" | sed 's/../&:/g;s/:$//')
        log "FACTORY MAC FOUND at offset 0x28: $MAC"
    else
        log "Offset 0x28 contains multicast MAC ($mac_raw), ignoring."
    fi
fi

# === 2. Fallback: хэш от первых 64 байт mtd2 ===
if [ -z "$MAC" ]; then
    h=$(head -c 64 /dev/mtd2 2>/dev/null | sha256sum | awk '{print $1}')
    if [ -n "$h" ] && [ "$h" != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
        MAC="02:$(echo "$h" | cut -c3-4):$(echo "$h" | cut -c5-6):$(echo "$h" | cut -c7-8):$(echo "$h" | cut -c9-10):$(echo "$h" | cut -c11-12)"
        log "SILICON HASH FALLBACK. MAC: $MAC"
    else
        log "WARNING: mtd2 read error or empty. MAC unchanged."
        exit 0
    fi
fi

# === 3. Только запись в UCI, без ip link ===
if [ -n "$MAC" ]; then
    uci set network.lan.macaddr="$MAC"
    uci commit network
    log "UCI set: network.lan.macaddr=$MAC"
fi

exit 0
