#!/bin/sh

TAG="mac-fixer"

log()
{
	echo "<4>[$TAG]: $*" > /dev/kmsg
}

# Мгновенно вынимаем хэш, чтобы просто вывести его в логи для нашего спокойствия
h=$(head -c 64 /dev/mtd2 2>/dev/null | sha256sum | awk '{print $1}')
MAC="02:$(echo "$h" | cut -c3-4):$(echo "$h" | cut -c5-6):$(echo "$h" | cut -c7-8):$(echo "$h" | cut -c9-10):$(echo "$h" | cut -c11-12)"

log "NATIVE KERNEL INITIALIZATION COMPLETED. REPOSITORIES LOCKED TO: $MAC"
exit 0
