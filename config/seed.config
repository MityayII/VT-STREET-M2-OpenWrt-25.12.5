CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_vertell_vt-mt7621d=y

# === Отключение Wi-Fi ===
CONFIG_PACKAGE_kmod-mac80211=n

# === Драйверы модема (перенесено из профиля) ===
#CONFIG_PACKAGE_kmod-usb-acm=y
#CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
#CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
#CONFIG_PACKAGE_kmod-usb-serial-option=y
#CONFIG_PACKAGE_uqmi=y

# === Веб-интерфейс ===
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_ru=y

# === Диагностика и терминал ===
CONFIG_PACKAGE_picocom=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-ru=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-ru=y

# === Управление модемом (fildunsky) ===
CONFIG_PACKAGE_luci-app-5gmodem=y

# === Вспомогательные пакеты ===
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# === IPv6 (для LuCI) ===
CONFIG_PACKAGE_luci-proto-ipv6=y

#=== Наш пакет + тема bootstrap ===
CONFIG_PACKAGE_vtmodem=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-footstrap=y

